{
  "commands": [
    {
      "id": "jrender-upload",
      "name": "jrender 搜刮当前影片并上传（Playwright）",
      "description": "真浏览器渲染，自动过年龄验证；比 jfetch 慢，但 JS 页面和风控都能过",
      "type": "scrape-upload",
      "executable": "node",
      "args": [
        "${hostDir}/scraper/browser-scraper.mjs",
        "-k",
        "${key}",
        "-o",
        "${outputDir}"
      ],
      "timeoutSeconds": 600,
      "params": [
        {
          "key": "key",
          "label": "番号",
          "type": "text",
          "required": true,
          "default": "${num}",
          "placeholder": "留空则用当前影片的番号"
        },
        {
          "key": "cookie",
          "label": "Cookie",
          "type": "text",
          "placeholder": "留空则读 scraper/cookie.txt",
          "arg": [
            "--cookie",
            "${value}"
          ]
        },
        {
          "key": "origin",
          "label": "站点",
          "type": "text",
          "default": "https://www.javbus.com",
          "placeholder": "直连不通可换镜像域名",
          "arg": [
            "--origin",
            "${value}"
          ]
        },
        {
          "key": "headless",
          "label": "无头模式",
          "type": "boolean",
          "default": "true",
          "flagTrue": "--headless",
          "flagFalse": "--no-headless"
        },
        {
          "key": "debug",
          "label": "保存原始页面",
          "type": "boolean",
          "default": "false",
          "flagTrue": "--debug-html"
        }
      ]
    },
    {
      "id": "catch-upload",
      "name": "jcatch 搜刮当前影片并上传",
      "description": "用当前详情页的番号调用 jcatch 抓取元数据，打包后上传回服务器",
      "type": "scrape-upload",
      "executable": "G:\\project\\bin\\jcatch.exe",
      "args": [
        "-k",
        "${key}",
        "-o",
        "${outputDir}"
      ],
      "workingDirectory": "G:\\project\\bin",
      "timeoutSeconds": 900,
      "params": [
        {
          "key": "key",
          "label": "番号",
          "type": "text",
          "required": true,
          "default": "${num}",
          "placeholder": "留空则用当前影片的番号"
        },
        {
          "key": "headless",
          "label": "无头模式",
          "type": "boolean",
          "default": "true",
          "flagTrue": "--headless",
          "flagFalse": "--no-headless"
        },
        {
          "key": "chromedriver",
          "label": "ChromeDriver",
          "type": "file",
          "default": "G:\\project\\chromedriver\\157.0.8103.81\\chromedriver.exe",
          "placeholder": "留空则自动查找",
          "arg": [
            "--chromedriver-path",
            "${value}"
          ]
        }
      ]
    },
    {
      "id": "jcatch-video",
      "name": "jcatch 处理本地视频文件",
      "description": "对本机某个视频文件跑 jcatch，产出整理到输出目录（不经过服务器）",
      "type": "process",
      "executable": "G:\\project\\bin\\jcatch.exe",
      "args": [
        "-v",
        "${videoPath}"
      ],
      "workingDirectory": "G:\\project\\bin",
      "timeoutSeconds": 900,
      "params": [
        {
          "key": "videoPath",
          "label": "视频文件",
          "type": "file",
          "required": true,
          "noArg": true
        },
        {
          "key": "outputDir",
          "label": "输出目录",
          "type": "directory",
          "placeholder": "默认当前目录",
          "arg": [
            "--output",
            "${value}"
          ]
        },
        {
          "key": "key",
          "label": "番号",
          "type": "text",
          "placeholder": "留空则从文件名解析",
          "arg": [
            "--key",
            "${value}"
          ]
        },
        {
          "key": "headless",
          "label": "无头模式",
          "type": "boolean",
          "default": "true",
          "flagTrue": "--headless",
          "flagFalse": "--no-headless"
        },
        {
          "key": "clean",
          "label": "清理源文件",
          "type": "boolean",
          "default": "false",
          "flagTrue": "--clean"
        },
        {
          "key": "zip",
          "label": "打包输出",
          "type": "boolean",
          "default": "false",
          "flagTrue": "--zip-output"
        },
        {
          "key": "chromedriver",
          "label": "ChromeDriver",
          "type": "file",
          "default": "G:\\project\\chromedriver\\157.0.8103.81\\chromedriver.exe",
          "placeholder": "留空则自动查找",
          "arg": [
            "--chromedriver-path",
            "${value}"
          ]
        }
      ]
    },
    {
      "id": "jsearch",
      "name": "jsearch 扫描目录并搜刮",
      "description": "递归扫描目录，按大小筛选后调用 jcatch 处理，结果整理到输出目录",
      "type": "process",
      "executable": "G:\\project\\bin\\jsearch.exe",
      "args": [
        "${directory}"
      ],
      "workingDirectory": "G:\\project\\bin",
      "timeoutSeconds": 7200,
      "params": [
        {
          "key": "directory",
          "label": "扫描目录",
          "type": "directory",
          "required": true,
          "noArg": true,
          "default": "G:\\迅雷下载"
        },
        {
          "key": "outputDir",
          "label": "输出目录",
          "type": "directory",
          "placeholder": "默认当前目录",
          "arg": [
            "--output",
            "${value}"
          ],
          "default": "F:\\迅雷下载\\emby_out"
        },
        {
          "key": "minSize",
          "label": "最小大小",
          "type": "text",
          "default": "1G",
          "placeholder": "1G / 500M / 1024",
          "arg": [
            "--min-size",
            "${value}"
          ]
        },
        {
          "key": "limit",
          "label": "数量上限",
          "type": "number",
          "default": "3",
          "placeholder": "默认 3",
          "arg": [
            "--limit",
            "${value}"
          ]
        },
        {
          "key": "headless",
          "label": "无头模式",
          "type": "boolean",
          "default": "true",
          "flagTrue": "--headless",
          "flagFalse": "--no-headless"
        },
        {
          "key": "verbose",
          "label": "详细日志",
          "type": "boolean",
          "default": "true",
          "flagTrue": "--verbose"
        },
        {
          "key": "chromedriver",
          "label": "ChromeDriver",
          "type": "file",
          "default": "G:\\project\\chromedriver\\157.0.8103.81\\chromedriver.exe",
          "placeholder": "留空则自动查找",
          "arg": [
            "--chromedriver-path",
            "${value}"
          ]
        }
      ],
      "hidden": true
    },
    {
      "id": "jscan",
      "name": "jscan 扫描目录批量搜刮（Playwright）",
      "description": "递归扫描目录，逐部用浏览器搜刮，视频和元数据一起整理进输出目录；不依赖 jcatch / chromedriver",
      "type": "process",
      "executable": "node",
      "args": [
        "${hostDir}/scraper/scan-scraper.mjs",
        "${directory}"
      ],
      "timeoutSeconds": 14400,
      "params": [
        {
          "key": "directory",
          "label": "扫描目录",
          "type": "directory",
          "required": true,
          "default": "G:\\迅雷下载",
          "noArg": true
        },
        {
          "key": "outputDir",
          "label": "输出目录",
          "type": "directory",
          "default": "F:\\迅雷下载\\emby_out",
          "arg": [
            "-o",
            "${value}"
          ]
        },
        {
          "key": "minSize",
          "label": "最小大小",
          "type": "text",
          "default": "1G",
          "placeholder": "1G / 500M / 1024(MB)",
          "arg": [
            "-m",
            "${value}"
          ]
        },
        {
          "key": "limit",
          "label": "数量上限",
          "type": "number",
          "default": "3",
          "placeholder": "0 = 不限",
          "arg": [
            "-l",
            "${value}"
          ]
        },
        {
          "key": "dryRun",
          "label": "只看计划",
          "type": "boolean",
          "default": "false",
          "flagTrue": "--dry-run"
        },
        {
          "key": "headless",
          "label": "无头模式",
          "type": "boolean",
          "default": "true",
          "flagTrue": "--headless",
          "flagFalse": "--no-headless"
        },
        {
          "key": "cookie",
          "label": "Cookie",
          "type": "text",
          "placeholder": "留空则读 scraper/cookie.txt",
          "arg": [
            "--cookie",
            "${value}"
          ]
        },
        {
          "key": "origin",
          "label": "站点",
          "type": "text",
          "default": "https://www.javbus.com",
          "placeholder": "直连不通可换镜像域名",
          "arg": [
            "--origin",
            "${value}"
          ]
        }
      ],
      "hidden": true
    },
    {
      "id": "jfetch-upload",
      "name": "jfetch 搜刮当前影片并上传（不用浏览器）",
      "description": "纯 HTTP 抓取，不启动 Chrome，单部 1~2 秒。首次需要填一次 Cookie",
      "type": "scrape-upload",
      "executable": "node",
      "args": [
        "${hostDir}/scraper/http-scraper.mjs",
        "-k",
        "${key}",
        "-o",
        "${outputDir}"
      ],
      "timeoutSeconds": 300,
      "params": [
        {
          "key": "key",
          "label": "番号",
          "type": "text",
          "required": true,
          "default": "${num}",
          "placeholder": "留空则用当前影片的番号"
        },
        {
          "key": "cookie",
          "label": "Cookie",
          "type": "text",
          "placeholder": "留空则读 scraper/cookie.txt",
          "arg": [
            "--cookie",
            "${value}"
          ]
        },
        {
          "key": "origin",
          "label": "站点",
          "type": "text",
          "default": "https://www.javbus.com",
          "placeholder": "直连不通可换镜像域名",
          "arg": [
            "--origin",
            "${value}"
          ]
        },
        {
          "key": "debug",
          "label": "保存原始页面",
          "type": "boolean",
          "default": "false",
          "flagTrue": "--debug-html"
        }
      ]
    }
  ],
  "snippets": [
    {
      "name": "① 只看计划（不动任何文件）",
      "description": "先确认会处理哪些番号、有哪些只差一半。\n参数：-m 1G 体积下限 ｜ -l 10 本次最多 10 部（0 = 不限）｜ --headless 无头浏览器 ｜ --delay 5-10 每部间隔秒数 ｜ --origin 换镜像站点 ｜ --cookie 留空则读 scraper\\cookie.txt",
      "command": "node \"${hostDir}\\scraper\\scan-scraper.mjs\" \"G:\\迅雷下载\" -o \"F:\\迅雷下载\\emby_out\" -m 1G -l 10 --headless --dry-run"
    },
    {
      "name": "② 正式跑（推荐）",
      "description": "搜刮 + 移动，跨盘会复制（有进度）。跑完再看下一批。\n参数：-m 1G 体积下限 ｜ -l 10 本次最多 10 部（0 = 不限）｜ --headless 无头浏览器 ｜ --delay 5-10 每部间隔秒数 ｜ --origin 换镜像站点 ｜ --cookie 留空则读 scraper\\cookie.txt",
      "command": "node \"${hostDir}\\scraper\\scan-scraper.mjs\" \"G:\\迅雷下载\" -o \"F:\\迅雷下载\\emby_out\" -m 1G -l 10 --headless"
    },
    {
      "name": "③ 大批量（不限数量，适合挂一晚上）",
      "description": "一次跑完所有候选，注意跨盘复制按 GB 算，几百部可能要几十小时；建议用桌面「批量搜刮」快捷方式跑，关浏览器不影响。",
      "command": "node \"${hostDir}\\scraper\\scan-scraper.mjs\" \"G:\\迅雷下载\" -o \"F:\\迅雷下载\\emby_out\" -m 1G -l 0 --headless"
    },
    {
      "name": "④ 只整理不搜刮（不联网）",
      "description": "只把视频移进输出目录，适合已经搜刮过的片子。\n参数：-m 1G 体积下限 ｜ -l 10 本次最多 10 部（0 = 不限）｜ --headless 无头浏览器 ｜ --delay 5-10 每部间隔秒数 ｜ --origin 换镜像站点 ｜ --cookie 留空则读 scraper\\cookie.txt",
      "command": "node \"${hostDir}\\scraper\\scan-scraper.mjs\" \"G:\\迅雷下载\" -o \"F:\\迅雷下载\\emby_out\" -m 1G -l 10 --skip-scrape"
    },
    {
      "name": "⑤ 排查用（只跑 1 部 + 显示浏览器）",
      "description": "解析不到、验证码过不去时，跑这一条看着浏览器找原因；--debug-html 可另加",
      "command": "node \"${hostDir}\\scraper\\scan-scraper.mjs\" \"G:\\迅雷下载\" -o \"F:\\迅雷下载\\emby_out\" -m 1G -l 1 --no-headless --debug-html"
    },
    {
      "name": "⑥ jsearch 批量（jcatch / chromedriver，慢但能过验证）",
      "description": "老方案，走 Selenium。参数：--min-size 1G 体积下限 ｜ --limit 10 最多 10 部 ｜ --headless 无头 ｜ --verbose 详细日志 ｜ --chromedriver-path 驱动路径",
      "command": "\"G:\\project\\bin\\jsearch.exe\" \"G:\\迅雷下载\" --output \"F:\\迅雷下载\\emby_out\" --min-size 1G --limit 10 --headless --verbose --chromedriver-path \"G:\\project\\chromedriver\\157.0.8103.81\\chromedriver.exe\""
    }
  ]
}
