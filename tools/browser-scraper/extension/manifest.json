{
  "manifest_version": 3,
  "name": "MediaHouse 本地工具",
  "version": "0.3.0",
  "description": "在 MediaHouse 页面上执行本机配置好的命令（jcatch / jsearch 等），实时查看终端日志。",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
